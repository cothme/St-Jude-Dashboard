DATABASE_URL="postgresql://postgres:postgres@localhost:5432/st_jude_admin?schema=public"
PORT=3001
CLIENT_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_SECRET="generate-a-long-random-secret-of-at-least-32-characters"
JSON_BODY_LIMIT="2mb"
UPLOADTHING_TOKEN="copy-the-api-keys-v7-token-from-uploadthing-dashboard"
# Local dev uses http unless you configured TLS locally.
UPLOADTHING_CALLBACK_URL="http://localhost:3001/api/uploadthing"
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="30"
